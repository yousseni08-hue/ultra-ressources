# ── Obligatoire ─────────────────────────────────────────────
# Incoming Webhook Slack du canal où les setters reçoivent les leads (#leads-magnets)
SLACK_WEBHOOK_URL=
# Chaîne aléatoire longue (openssl rand -hex 32). Signe l'accès aux ressources.
LEAD_TOKEN_SECRET=
# Lien de réservation iClosed (le bouton "Réserver mon appel" en fin de ressource)
NEXT_PUBLIC_ICLOSED_URL=

# ── Recommandé ──────────────────────────────────────────────
# Meta Pixel (events Lead / ViewContent / Schedule pour le retargeting)
NEXT_PUBLIC_META_PIXEL_ID=
# Google Sheet historique des leads : URL /exec du Apps Script (scripts/apps-script.gs)
SHEET_WEBHOOK_URL=

# ── Optionnel ───────────────────────────────────────────────
# Crée le lead dans Close CRM automatiquement
CLOSE_API_KEY=
# CA annuel (€) à partir duquel la notif Slack est marquée 🔥 PRIORITAIRE
LEAD_PRIORITY_MIN_CA=300000
# Webhook générique : reçoit chaque lead en JSON (n8n, base interne, CRM maison...)
LEAD_FORWARD_WEBHOOK_URL=
